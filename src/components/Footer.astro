---
import { Image } from "astro:assets";
import { assets, socials } from "../data/assets";
---

<footer class="footer wrap">
  <div class="footer-top">
    <a href="/" class="footer-brand">
      <Image
        src={assets.wordmark.image}
        alt={assets.wordmark.alt}
        width={280}
        loading="lazy"
      />
    </a>
    <p>
      Rooted in Pahrump.
      <br />
      Focused on your next chapter.
    </p>
    <a class="text-link" href="#main">
      Back to top ↑
    </a>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Marci Metzger</span>
    <div class="socials">
      {socials.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${social.label} (opens in a new tab)`}
        >
          <Image src={social.image} alt="" width={22} loading="lazy" />
        </a>
      ))}
    </div>

  </div>
</footer>
