---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import ProfileCard from "../components/ProfileCard";
import PropertyCollection from "../components/PropertyCollection";
import Reviews from "../components/Reviews.astro";
import { assets, collection, collectionDetails } from "../data/assets";
const portraitSizes = await Promise.all(
  [320, 480, 730].map((width) =>
    getImage({ src: assets.portrait.image, width, format: "webp" }),
  ),
);
const portraitSrcSet = portraitSizes
  .map((image, index) => `${image.src} ${[320, 480, 730][index]}w`)
  .join(", ");
const items = await Promise.all(
  collection.map(async (item) => ({
    src: (await getImage({ src: item.asset.image, width: 800, format: "webp" }))
      .src,
    alt: item.asset.alt,
    title: item.title,
    subtitle: item.subtitle,
    fullSrc: (
      await getImage({
        src: item.asset.image,
        width: item.asset.image.width,
        format: "webp",
      })
    ).src,
  })),
);
---

<Layout>
  <main id="main">
    <section class="hero" id="default" aria-labelledby="hero-title">
      <Image
        class="hero-landscape"
        src={assets.hero.image}
        alt={assets.hero.alt}
        widths={[640, 960, 1440, 1920]}
        sizes="(max-width:700px) 180vw, 100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
      />
      <div class="hero-shade"></div>
      <div class="hero-content wrap">
        <div class="hero-copy">
          <p class="eyebrow">
            PAHRUMP, NEVADA <span class="tiny-line"></span> A PLACE TO BELONG
          </p>
          <h1 id="hero-title">
            A doorway to
            <br />
            <em>exceptional</em>
            <br />
            living.
          </h1>
          <p class="hero-description">
            An extraordinary place. A personal approach.
            <br />
            Let’s open the door to your next chapter.
          </p>
          <div class="hero-actions">
            <a href="#collection" class="button button-light">
              Explore properties <span aria-hidden="true">↗</span>
            </a>
            <a href="#about" class="quiet-link">
              Meet your agent <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="portrait-composition">
          <div class="black-square" aria-hidden="true">
            <span>
              LOCAL ROOTS.
              <br />
              NEW POSSIBILITIES.
            </span>
            <span class="square-arrow">↗</span>
          </div>
          <ProfileCard
            client:load
            className="marci-profile marci-profile--hero"
            avatarUrl={portraitSizes[2].src}
            avatarSrcSet={portraitSrcSet}
            avatarSizes="(max-width:700px) 65vw, 28vw"
            loading="eager"
            name="Marci Metzger"
            title="The Ridge Realty Group"
            contactText="Meet Marci"
            contactHref="#about"
            theme="light"
            radius={14}
            holo={0.2}
            glare={0.3}
            tiltStrength={9}
            parallax={6}
            intro={false}
          />
        </div>
      </div>
      <div class="hero-bottom wrap">
        <span>01 / ARRIVAL</span>
        <a href="#perspective">
          SCROLL TO DISCOVER <span aria-hidden="true">↓</span>
        </a>
        <span>THE RIDGE REALTY GROUP</span>
      </div>
      <div
        class="doorway"
        id="doorway"
        hidden
        aria-label="Welcome to Marci Metzger Homes"
      >
        <div class="door-panel door-left">
          <div class="door-inset"></div>
          <span class="door-brand">
            MARCI
            <br />
            METZGER<small>A DOORWAY TO EXCEPTIONAL LIVING</small>
          </span>
          <i class="door-handle"></i>
        </div>
        <div class="door-panel door-right">
          <div class="door-inset"></div>
          <i class="door-handle"></i>
          <span class="door-number">
            01
            <br />
            <small>WELCOME HOME</small>
          </span>
        </div>
        <button id="skip-intro" type="button">
          Skip intro ↗
        </button>
      </div>
      <script is:inline>
        (() => {
          const doors = document.getElementById("doorway");
          const media = matchMedia("(prefers-reduced-motion: reduce)");
          let seen = false;
          try {
            seen = sessionStorage.getItem("marci-arrival") === "seen";
          } catch {}
          if (seen || media.matches) return;
          doors.hidden = false;
          let start, finish;
          const close = () => {
            clearTimeout(start);
            clearTimeout(finish);
            doors.hidden = true;
            try {
              sessionStorage.setItem("marci-arrival", "seen");
            } catch {}
            window.removeEventListener("scroll", close);
            window.removeEventListener("keydown", key);
            media.removeEventListener("change", close);
          };
          const key = (e) => {
            if (e.key === "Escape" || e.key === "Tab") close();
          };
          document
            .getElementById("skip-intro")
            .addEventListener("click", close, { once: true });
          window.addEventListener("scroll", close, {
            once: true,
            passive: true,
          });
          window.addEventListener("keydown", key);
          media.addEventListener("change", close);
          start = setTimeout(() => {
            doors.classList.add("opening");
            document
              .querySelector(".hero-landscape")
              .animate(
                [{ transform: "scale(1.045)" }, { transform: "scale(1)" }],
                { duration: 2100, easing: "cubic-bezier(.2,.7,.2,1)" },
              );
            document
              .querySelectorAll(".hero-copy > *, .portrait-composition")
              .forEach((el, i) =>
                el.animate(
                  [
                    { opacity: 0, transform: "translateY(18px)" },
                    { opacity: 1, transform: "translateY(0)" },
                  ],
                  {
                    duration: 900,
                    delay: 400 + i * 95,
                    easing: "cubic-bezier(.2,.7,.2,1)",
                    fill: "backwards",
                  },
                ),
              );
          }, 180);
          finish = setTimeout(close, 2400);
        })();
      </script>
    </section>
    <section class="perspective wrap section-space" id="perspective">
      <div class="section-kicker">
        <p class="eyebrow">02 / A DIFFERENT PERSPECTIVE</p>
        <span class="small-cross" aria-hidden="true">
          +
        </span>
      </div>
      <div class="statement-grid" data-reveal>
        <h2>
          A home is more
          <br />
          than an address.
          <br />
          <em>It’s a way of living.</em>
        </h2>
        <div class="statement-copy">
          <p>
            Space to breathe. A view that stays with you. A place that feels
            unmistakably yours.
          </p>
          <p>
            Whether you’re buying, selling, or simply exploring what comes next,
            a personal approach makes all the difference.
          </p>
          <a class="text-link" href="#contact">
            Find your next chapter <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <figure class="perspective-photo" data-reveal>
        <Image
          src={assets.home.image}
          alt={assets.home.alt}
          widths={[600, 1000, 1200]}
          sizes="90vw"
          loading="lazy"
        />
        <figcaption>
          <span>THE ART OF FEELING AT HOME</span>
          <span>SPACE. LIGHT. POSSIBILITY.</span>
        </figcaption>
      </figure>
    </section>
    <section
      class="collection"
      id="collection"
      aria-labelledby="collection-title"
    >
      <span id="search-listing" class="anchor-alias"></span>
      <div class="collection-intro wrap">
        <div class="section-kicker">
          <p class="eyebrow">03 / THE COLLECTION</p>
          <span class="eyebrow">A NEW POINT OF VIEW</span>
        </div>
        <div class="collection-heading" data-reveal>
          <h2 id="collection-title">
            Beautiful spaces.
            <br />
            <em>Endless possibilities.</em>
          </h2>
          <p>
            A closer look at the places and details
            <br />
            that make a home worth imagining.
          </p>
        </div>
      </div>
      <PropertyCollection
        items={items}
        details={collectionDetails}
        client:visible
      />
    </section>
    <section class="spotlight section-space wrap" id="purpose">
      <div class="spotlight-copy">
        <p class="eyebrow">04 / THE DETAILS THAT MATTER</p>
        <h2>
          Made for
          <br />
          <em>
            everyday
            <br />
            extraordinary.
          </em>
        </h2>
        <p>
          The morning light. The space to gather.
          <br />
          The small details that make it yours.
        </p>
        <a class="text-link" href="#contact">
          Let’s find your place ↗
        </a>
      </div>
      <div class="spotlight-images">
        <figure data-reveal>
          <Image
            src={assets.kitchen.image}
            alt={assets.kitchen.alt}
            widths={[500, 800, 1200]}
            sizes="(max-width:700px) 90vw, 52vw"
            loading="lazy"
          />
          <figcaption>
            <span>01 — ROOM TO GATHER</span>
            <span>INTERIORS</span>
          </figcaption>
        </figure>
        <figure class="keys-photo" data-reveal>
          <Image
            src={assets.keys.image}
            alt={assets.keys.alt}
            widths={[400, 700]}
            sizes="(max-width:700px) 80vw, 38vw"
            loading="lazy"
          />
          <figcaption>
            <span>02 — YOUR NEXT CHAPTER</span>
            <span>BUYING & SELLING</span>
          </figcaption>
        </figure>
      </div>
    </section>
    <section class="about section-space" id="about">
      <div class="wrap about-grid">
        <div class="about-portrait" data-reveal>
          <ProfileCard
            client:visible
            className="marci-profile marci-profile--about"
            avatarUrl={portraitSizes[2].src}
            avatarSrcSet={portraitSrcSet}
            avatarSizes="(max-width:700px) 80vw, 38vw"
            name="Marci Metzger"
            title="Your real estate professional"
            contactText="Let’s talk"
            contactHref="tel:+12069196886"
            theme="light"
            radius={16}
            holo={0.2}
            glare={0.3}
            tiltStrength={9}
            parallax={6}
            intro={false}
          />
        </div>

        <div class="about-copy" data-reveal>
          <p class="eyebrow">05 / YOUR REAL ESTATE PROFESSIONAL</p>
          <h2>
            A familiar face.
            <br />
            <em>A fresh chapter.</em>
          </h2>
          <h3>Meet Marci Metzger.</h3>
          <p>
            Since beginning her real estate career in 1995, Marci has guided
            clients through a wide variety of market conditions. Her background
            includes a successful career as a REALTOR and licensed Broker in
            Washington State.
          </p>
          <p>
            Today, connect with Marci at The Ridge Realty Group in Pahrump for a
            conversation about buying, selling, and your next move.
          </p>
          <a class="button button-dark" href="tel:+12069196886">
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
          <div class="signature">Marci Metzger</div>
        </div>
      </div>
      <div class="affiliations wrap" id="affiliations">
        <p class="eyebrow">
          LOCAL CONNECTIONS.
          <br />
          SHARED STANDARDS.
        </p>
        {[assets.ridge, assets.chamber, assets.realtor].map((asset) => (
          <Image
            src={asset.image}
            alt={asset.alt}
            width={140}
            height={140}
            loading="lazy"
          />
        ))}
      </div>
    </section>
    <Reviews />
    <section class="lifestyle section-space wrap" id="services">
      <div class="section-kicker">
        <p class="eyebrow">07 / PLACES, SPACES & LIFESTYLE</p>
        <span aria-hidden="true">↗</span>
      </div>
      <div class="lifestyle-heading" data-reveal>
        <h2>
          Find your kind
          <br />
          <em>of extraordinary.</em>
        </h2>
        <p>
          From a fresh perspective on a space
          <br />
          to a thoughtful conversation about your future.
        </p>
      </div>
      <div class="lifestyle-grid">
        {[
          {
            asset: assets.interior,
            title: "A space that works for you",
            copy: "Look closer at the everyday details.",
          },
          {
            asset: assets.architecture,
            title: "A place to call your own",
            copy: "Imagine the possibilities of a new home.",
          },
          {
            asset: assets.service,
            title: "A person in your corner",
            copy: "Let’s talk through your next move.",
          },
        ].map((item, i) => (
          <article data-reveal>
            <Image
              src={item.asset.image}
              alt={item.asset.alt}
              widths={[360, 600, 730]}
              sizes="(max-width:700px) 90vw, 30vw"
              loading="lazy"
            />
            <p class="eyebrow">
              0{i + 1} / {["SPACES", "PLACES", "PEOPLE"][i]}
            </p>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="contact section-space" id="contact">
      <span id="contacts" class="anchor-alias"></span>
      <div class="wrap">
        <div class="section-kicker">
          <p class="eyebrow">08 / YOUR NEXT CHAPTER</p>
          <span class="eyebrow">LET’S OPEN THE DOOR</span>
        </div>
        <div class="contact-grid">
          <h2>
            Good things
            <br />
            start with
            <br />
            <em>a conversation.</em>
          </h2>
          <div class="contact-information">
            <a class="contact-phone" href="tel:+12069196886">
              (206) 919-6886 <span aria-hidden="true">↗</span>
            </a>
            <div class="contact-address">
              <p>
                MARCI METZGER
                <br />
                THE RIDGE REALTY GROUP
              </p>
              <address>
                3190 HW-160, Suite F<br />
                Pahrump, Nevada 89048
              </address>
              <p>Office hours: 8:00 am–7:00 pm, daily</p>
            </div>
            <a
              class="text-link"
              href="https://www.google.com/maps/search/?api=1&query=3190+HW-160+Suite+F+Pahrump+NV+89048"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit the office ↗
            </a>
            <div class="office-map">
              <iframe
                src="https://www.google.com/maps/embed?origin=mfe&pb=!1m3!2m1!1s3190+HW-160,+Suite+F,+Pahrump,+Nevada+89048!6i16"
                title="Google map showing the office at 3190 HW-160, Suite F, Pahrump, Nevada"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              >
              </iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
